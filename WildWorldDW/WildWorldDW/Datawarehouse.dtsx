                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    si.StockItemID                          AS [WWI Stock Item ID],
    si.StockItemName                        AS [Stock Item],
    ISNULL(co.ColorName, 'N/A')             AS [Color],
    ISNULL(si.Brand, 'N/A')                 AS [Brand],
    ISNULL(si.Size, 'N/A')                  AS [Size],
    si.UnitPrice                            AS [Unit Price],
    ISNULL(si.RecommendedRetailPrice, 0)    AS [Recommended Retail Price],
    si.TypicalWeightPerUnit                 AS [Typical Weight Per Unit],
    CAST(si.ValidFrom AS DATE)              AS [EffectiveDate],
    CAST(si.ValidTo AS DATE)                AS [EndDate],
    1                                       AS [IsCurrent]
FROM Warehouse.StockItems si
LEFT JOIN Warehouse.Colors co  ON si.ColorID       = co.ColorID
JOIN Warehouse.PackageTypes up ON si.UnitPackageID = up.PackageTypeID
JOIN Warehouse.PackageTypes op ON si.OuterPackageID = op.PackageTypeID
WHERE si.ValidTo = '9999-12-31 23:59:59.9999999'</property>
