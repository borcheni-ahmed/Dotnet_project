var builder = WebApplication.CreateBuilder(args);

// Ensure the app listens on known HTTP and HTTPS ports so
// UseHttpsRedirection can determine the HTTPS port for redirects.
// These URLs are used for local development; change as needed.
builder.WebHost.UseUrls("https://localhost:5001", "http://localhost:5000");

// Add services to the container.

builder.Services.AddControllers();
// OpenAPI/Swagger setup is optional. It's compiled only when the `ENABLE_SWAGGER` symbol is defined.
// To enable locally, set the MSBuild property `EnableSwagger` to `true` (or define the
// `ENABLE_SWAGGER` constant) so the package is referenced and the code below is included.
#if ENABLE_SWAGGER
#if ENABLE_SWAGGER
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(options =>
{
    options.SwaggerDoc("v1", new Microsoft.OpenApi.Models.OpenApiInfo
    {
        Title = "Dotnet_Project API",
        Version = "v1"
    });
});
#endif
#endif

var app = builder.Build();

// Configure the HTTP request pipeline.
#if ENABLE_SWAGGER
if (app.Environment.IsDevelopment())
{   
    
    app.UseSwagger();
    app.UseSwaggerUI();
}
#endif

app.UseHttpsRedirection();

app.UseAuthorization();

app.MapControllers();

app.Run();
