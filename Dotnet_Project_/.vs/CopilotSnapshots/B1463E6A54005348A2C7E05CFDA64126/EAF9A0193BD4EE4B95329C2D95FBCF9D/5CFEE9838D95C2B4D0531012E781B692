<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- No external package references required for this workspace. Add PackageReference
       entries here only when package restore is available. -->

  <!-- Optional: enable Swagger by setting the EnableSwagger MSBuild property to true
       (or define the ENABLE_SWAGGER constant). When enabled, the Swashbuckle package
       will be referenced and Swagger middleware will be compiled into the app. -->
  <PropertyGroup>
    <EnableSwagger>true</EnableSwagger>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableSwagger)' == 'true'">
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\DataWarehouse\" />
    <Folder Include="DTOs\" />
    <Folder Include="Security\" />
    <Folder Include="Repositories\Interfaces\" />
    <Folder Include="Repositories\Implementations\" />
  </ItemGroup>

  <!-- No compile file removals. All source files are always compiled; Swagger is enabled
       only via the ENABLE_SWAGGER constant and the conditional PackageReference above. -->

  <!-- Define a compilation constant when EnableSwagger is true -->
  <PropertyGroup Condition="'$(EnableSwagger)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_SWAGGER</DefineConstants>
  </PropertyGroup>

</Project>
