  "components": {
    "schemas": {
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "expiration": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CustomerDto": {
        "required": [
          "customerName"
        ],
        "type": "object",
        "properties": {
          "customerID": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "customerName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "deliveryAddressLine1": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "deliveryAddressLine2": {
            "maxLength": 60,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "postalCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "deliveryCityID": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "cityName": {
            "type": "string",
            "nullable": true
          },
          "standardDiscountPercentage": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "isOnCreditHold": {
            "type": "boolean"
          },
          "paymentDays": {
            "type": "integer",
            "format": "int32"
          },
          "totalOrders": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "KPIsDto": {
        "type": "object",
        "properties": {
          "totalRevenue": {
            "type": "number",
            "format": "double"
          },
          "totalProfit": {
            "type": "number",
            "format": "double"
          },
          "totalOrders": {
            "type": "integer",
            "format": "int32"
          },
          "totalCustomers": {
            "type": "integer",
            "format": "int32"
          },
          "totalProducts": {
            "type": "integer",
            "format": "int32"
          },
          "averageOrderValue": {
            "type": "number",
            "format": "double"
          },
          "profitMargin": {
            "type": "number",
            "format": "double"
          },
          "revenueGrowth": {
            "type": "number",
            "format": "double"
          },
          "orderGrowth": {
            "type": "number",
            "format": "double"
          },
          "profitGrowth": {
            "type": "number",
            "format": "double"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrderDto": {
        "required": [
          "customerID",
          "expectedDeliveryDate",
          "orderDate"
        ],
        "type": "object",
        "properties": {
          "orderID": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "customerID": {
            "type": "integer",
            "format": "int32"
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "orderDate": {
            "type": "string",
            "format": "date-time"
          },
          "expectedDeliveryDate": {
            "type": "string",
            "format": "date-time"
          },
          "customerPurchaseOrderNumber": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "comments": {
            "type": "string",
            "nullable": true
          },
          "deliveryInstructions": {
            "type": "string",
            "nullable": true
          },
          "isUndersupplyBackordered": {
            "type": "boolean"
          },
          "pickingCompletedWhen": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "required": [
          "email",
          "password",
          "role",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "pattern": "^(Admin|User)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SalesByCountryDto": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "nullable": true
