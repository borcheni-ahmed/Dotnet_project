<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- No external package references required for this workspace. Add PackageReference
       entries here only when package restore is available. -->

  <!-- Optional: enable Swagger by setting the EnableSwagger MSBuild property to true
       (or define the ENABLE_SWAGGER constant). When enabled, the Swashbuckle package
       will be referenced and Swagger middleware will be compiled into the app. -->
  <PropertyGroup>
    <EnableSwagger>true</EnableSwagger>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableSwagger)' == 'true'">
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <!-- Entity Framework Core packages for DbContext and DbSet -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ExternalStubs\" />
    <Folder Include="Security\" />
  </ItemGroup>

  <!-- No compile file removals. All source files are always compiled; Swagger is enabled
       only via the ENABLE_SWAGGER constant and the conditional PackageReference above. -->

  <!-- Define a compilation constant when EnableSwagger is true -->
  <PropertyGroup Condition="'$(EnableSwagger)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_SWAGGER</DefineConstants>
  </PropertyGroup>

</Project>
